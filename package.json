{
  "name": "lazytypr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json && node scripts/stage-native-helper.mjs",
    "build:renderer": "vite build",
    "check": "npm run typecheck && npm run test:unit && npm run build:renderer && npm run test:electron && npm run test:cycles && npm run test:security && npm run test:licensing && npm run check:privacy",
    "check:privacy": "node scripts/check-privacy.mjs",
    "dev": "npm run build:renderer && npm run build:main && electron .",
    "dev:smoke": "npm run build:renderer && npm run build:main && electron . --smoke",
    "sbom:development": "npm sbom --sbom-format spdx --package-lock-only --ignore-scripts --offline | node scripts/generate-development-sbom.mjs > artifacts/sbom/phase1-development.spdx.json",
    "test:cycles": "playwright test tests/integration/tracer.electron.spec.ts --grep \"20 local cycles\"",
    "test:electron": "playwright test tests/integration --pass-with-no-tests --grep-invert \"20 local cycles\"",
    "test:licensing": "vitest run --config vitest.security.config.ts",
    "test:security": "node scripts/check-security.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "verify:hardware-evidence": "node scripts/validate-phase1-run-sheet.mjs"
  },
  "dependencies": {
    "electron": "41.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "typescript": "6.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
