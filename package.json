{
  "name": "lazytypr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:renderer": "vite build",
    "check": "npm run typecheck && npm run test:unit && npm run build:renderer && npm run test:electron && npm run test:security && npm run check:privacy",
    "check:privacy": "node scripts/check-privacy.mjs",
    "test:electron": "playwright test tests/integration --pass-with-no-tests",
    "test:security": "node scripts/check-security.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "electron": "41.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "typescript": "6.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
